# Copiar a .env y cambiar los secretos. .env NUNCA se versiona.
POSTGRES_USER=mnemo
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=mnemo
# python -c "import secrets; print(secrets.token_hex(24))"
STORAGE_SECRET=cambia-esto
# Opcional: si se define, POST /api/import exige la cabecera X-API-Key (n8n, cron).
API_KEY=

APP_PORT=8095
DEFAULT_THEME=eren
TIMEZONE=America/Santiago
NEW_PER_DAY=20
DESIRED_RETENTION=0.9
IMPORT_ON_STARTUP=true

# Fuentes de conocimiento en el host (se montan en solo lectura). Rutas con / también en Windows.
VAULT_HOST_PATH=C:/dev/learning_center
CMDVAULT_HOST_PATH=C:/dev/projects/CmdVault/backend/app/seed/data
PROJECTS_HOST_PATH=C:/dev/projects

